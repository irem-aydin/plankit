# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # (eski projelerde: anon key)
SUPABASE_SECRET_KEY=sb_secret_xxx                         # (eski projelerde: service_role key) — ASLA istemciye verme

# Uygulamanın dış adresi (Stripe dönüş URL'leri ve e-posta doğrulama için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API (yapay zekâ ile kişiye özel plan) — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# Stripe — Developers > API keys / Webhooks, Product catalog > fiyat ID
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Her plan × dönem için Product catalog'da bir fiyat (tutarlar src/core/billing/plans.ts ile aynı olmalı)
STRIPE_PRICE_STARTER_MONTHLY=price_xxx   # Başlangıç, aylık 249 TL
STRIPE_PRICE_STARTER_YEARLY=price_xxx    # Başlangıç, yıllık 2.388 TL
STRIPE_PRICE_PRO_MONTHLY=price_xxx       # Profesyonel, aylık 499 TL
STRIPE_PRICE_PRO_YEARLY=price_xxx        # Profesyonel, yıllık 4.788 TL
STRIPE_PRICE_PACK=price_xxx              # Tek seferlik paket (3 kredi), 149 TL — tek seferlik fiyat

# Maliyet koruması — tüm site için 24 saatte en fazla plan üretimi (varsayılan 100)
# AI_GLOBAL_DAILY_JOB_LIMIT=100
